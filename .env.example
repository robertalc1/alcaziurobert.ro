# Environment variables for the Node server (server.js).
# Local dev: copy to .env.local, then run `node --env-file=.env.local server.js`.
# Production (Hosterion, cPanel → Setup Node.js App): add each one under
# "Environment variables" for the application, then restart the app.

# --- SMTP (contact form → email) ---

# SMTP server hostname (e.g. mail.alcaziurobert.ro, smtp.zoho.com)
SMTP_HOST=

# 587 (STARTTLS) or 465 (SSL). Secure mode is picked automatically for port 465.
SMTP_PORT=587

# SMTP login (usually the full email address)
SMTP_USER=contact@alcaziurobert.ro

# SMTP password — NEVER commit this.
SMTP_PASSWORD=

# "From" address shown to recipients. Defaults to SMTP_USER if unset.
SMTP_FROM=contact@alcaziurobert.ro

# Where contact form submissions are delivered. Accepts a comma-separated list,
# so leads can land in the mailbox AND in Gmail at the same time — keeping the
# Roundcube copy as the archive if Gmail ever filters something:
#   CONTACT_TO=contact@alcaziurobert.ro,adresa-ta@gmail.com
# The domain has valid SPF and DKIM (selector `default`), so mail sent this way
# authenticates and reaches the Gmail inbox rather than Spam.
CONTACT_TO=contact@alcaziurobert.ro

# Port the Node app listens on. cPanel/Passenger sets this itself; locally it
# defaults to 3000.
PORT=3000

# --- Meta Conversions API (server-side "Lead" event) ---
# Optional. When BOTH are set, /api/contact reports each delivered lead to
# Meta so ad campaigns can optimize on the Lead event — no client pixel, no
# cookies; email/phone are SHA-256 hashed. Leave empty to disable.
# NOTE: update the Privacy Policy before enabling in production.
# Pixel ID: Meta Events Manager → Data Sources. Token: Settings → Conversions API → Generate access token.
FB_PIXEL_ID=1555333129701586
FB_CAPI_ACCESS_TOKEN=

# Optional: test events code (Events Manager → Test events) — remove in production.
FB_CAPI_TEST_EVENT_CODE=

# --- Google Analytics 4 ---
# Measurement ID from GA4 Admin → Data Streams → your web stream (format
# G-XXXXXXXXXX). Loaded client-side only after a visitor accepts the
# "Performanță"/"Performance" cookie category in the consent banner — see
# src/lib/analytics.ts. VITE_* variables are baked into the bundle at BUILD
# time, so this one must be set wherever `npm run build` runs (locally, or as
# a GitHub Actions secret), not on the server.
VITE_GA_MEASUREMENT_ID=

# --- Meta Pixel (browser-side, Marketing consent category) ---
# Optional override for the pixel id hardcoded in src/lib/marketingPixels.ts.
# Like every VITE_* var it is inlined at BUILD time. The pixel only loads after
# the visitor accepts Marketing cookies.
VITE_FB_PIXEL_ID=1555333129701586

# --- Contact form protection ---
# The contact endpoint is the only path a lead can take, so it is rate limited
# in-process: max submissions per IP per 10 minutes, and a global ceiling per
# hour. Defaults (5 / 60) are generous for a real prospect and tight for a bot.
CONTACT_RATE_MAX_PER_IP=5
CONTACT_RATE_MAX_GLOBAL=60

# Note: every accepted lead is also appended to leads.jsonl next to server.js,
# BEFORE the email is sent, so an SMTP outage cannot lose a lead. The file holds
# personal data — it is gitignored and must not be served publicly.
